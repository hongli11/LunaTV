# arm/v7 运行时镜像。
# 策略：编译用 amd64（无 arm swc 二进制），运行用 arm/v7 + `next start`。
# standalone 会打包 amd64 node 二进制，不可用；改用完整 .next + next start。
# ---- 第 1 阶段：amd64 安装依赖 ----
FROM --platform=linux/amd64 node:20-alpine AS deps

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app
COPY package.json pnpm-lock.yaml ./

ENV PERSISTED_TO_FILE=true
RUN pnpm install --frozen-lockfile

# ---- 第 2 阶段：amd64 编译（webpack） ----
FROM --platform=linux/amd64 node:20-alpine AS builder
RUN corepack enable && corepack prepare pnpm@latest --activate
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

ENV DOCKER_ENV=true

RUN pnpm run build

# 在 amd64 builder 里裁掉 devDependencies（此处 pnpm 版本与 lockfile 一致）
RUN pnpm prune --prod --ignore-scripts --no-optional && \
    node -e "const p=require('./package.json'); console.log('pruned: kept',Object.keys(p.dependencies||{}).length,'prod / removed',Object.keys(p.devDependencies||{}).length,'dev')"

# ---- 第 3 阶段：arm/v7 运行时 ----
FROM node:20-alpine AS runner

RUN addgroup -g 1001 -S nodejs && adduser -u 1001 -S nextjs -G nodejs

WORKDIR /app
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
ENV DOCKER_ENV=true
ENV NEXT_PUBLIC_STORAGE_TYPE=redis
ENV STORAGE_TYPE=redis
ENV REDIS_URL=redis://redis:6379
# 站点访问密码 + 站长（owner）账号：登录时 username=admin 且 password=123456 即 owner 管理员
ENV USERNAME=admin
ENV PASSWORD=***

COPY --from=builder --chown=nextjs:nodejs /app/pnpm-lock.yaml ./
# 从 amd64 builder 拷贝已裁好的 node_modules（devDependencies 已 prune）
COPY --from=builder --chown=nextjs:nodejs /app/node_modules ./node_modules
# 复制完整 .next + 运行时文件 + scripts
COPY --from=builder --chown=nextjs:nodejs /app/package.json ./
COPY --from=builder --chown=nextjs:nodejs /app/scripts ./scripts
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next ./.next
COPY --from=builder --chown=nextjs:nodejs /app/next.config.js ./
COPY --from=builder --chown=nextjs:nodejs /app/tsconfig.json ./

USER nextjs

EXPOSE 3000

CMD ["npx", "next", "start", "-p", "3000", "-H", "0.0.0.0"]